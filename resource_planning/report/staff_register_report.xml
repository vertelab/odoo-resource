<odoo>
<template id="staff_register_report">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 t-esc='f"Place Name: {doc.name}"' />
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Name</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="doc.shift_ids" t-as="shift">
                            <tr>
                                <td t-esc="shift.date_start"/>
                                <td t-esc="shift.date_stop"/>
                                <td t-esc="shift.resource_id.name"/>
                                <td t-esc="shift.attendance_id.check_in"/>
                                <td t-esc="shift.attendance_id.check_out"/>
                            </tr>
                        </t>
                    </tbody>
                </table>

                </div>
            </t>
        </t>
    </t>
</template>

<record id="action_staff_register_report" model="ir.actions.report">
        <field name="name">Staff Register</field>
        <field name="model">resource.planning</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">resource_planning.staff_register_report</field>
        <field name="report_file">resource_planning.staff_register_report</field>
        <field name="print_report_name">'%s_report' % (object.name).replace('/','')</field>
        <field name="binding_model_id" ref="resource_planning.model_resource_planning"/>
        <field name="binding_type">report</field>
        <field name="attachment_use" eval="False"/>
    </record>

</odoo>
