<odoo>
<template id="staff_register_report">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 t-esc='f"Place Name: {doc.name}"' />
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Start Date</th>
                            <th>Social</th>
                            <th>Name</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="doc.shift_ids" t-as="shift">
                            <tr>
                                <td t-esc="doc.make_tz_aware(shift.date_start).strftime('%-d/%-m -%-y')"/>
<!--
                                <td t-esc="doc.make_tz_aware(shift.date_stop).strftime('%-d/%-m -%-y')"/>
-->
                                <td>
    <t t-if="shift.resource_id.employee_id">
        <t t-if="shift.resource_id.employee_id.identification_id">
            <span t-esc="shift.resource_id.employee_id.identification_id"/>
        </t>
        <t t-elif="shift.resource_id.employee_id.ssnid">
            <span t-esc="shift.resource_id.employee_id.ssnid"/>
        </t>
        <t t-elif="shift.resource_id.employee_id.passport_id">
            <span t-esc="shift.resource_id.employee_id.passport_id"/>
        </t>

        <t t-elif="not shift.resource_id.employee_id.passport_id">
            <span>None</span>
        </t>
            </t>
</td>
                                <td t-esc="shift.resource_id.employee_id.ssnid"/>
                                <td t-esc="shift.resource_id.name"/>
                                <td t-esc="doc.make_tz_aware(shift.attendance_id.check_in).strftime('%H:%M')"/>
                                <td t-esc="doc.make_tz_aware(shift.attendance_id.check_out).strftime('%H:%M')"/>
                            </tr>
                        </t>
                    </tbody>
                </table>

                </div>
            </t>
        </t>
    </t>
</template>

<record id="action_staff_register_report" model="ir.actions.report">
        <field name="name">Staff Register</field>
        <field name="model">resource.planning</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">resource_planning.staff_register_report</field>
        <field name="report_file">resource_planning.staff_register_report</field>
        <field name="print_report_name">'%s_report' % (object.name).replace('/','')</field>
        <field name="binding_model_id" ref="resource_planning.model_resource_planning"/>
        <field name="binding_type">report</field>
        <field name="attachment_use" eval="False"/>
    </record>

</odoo>
