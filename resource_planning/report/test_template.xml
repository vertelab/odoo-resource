<odoo>
<template id="report_resource_planning_shifts">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 t-esc='f"Resource Planning: {doc.name}"' />
                    <p t-esc="doc.shift_ids"/>
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Date Start</th>
                            <th>Date Stop</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="doc.shift_ids" t-as="shift">
                            <tr>
                                <td t-esc="shift.date_start"/>
                                <td t-esc="shift.date_stop"/>
                                <td t-esc="shift.attendance_id.check_in"/>
                                <td t-esc="shift.attendance_id.check_out"/>
                            </tr>
                        </t>
                    </tbody>
                </table>

                </div>
            </t>
        </t>
    </t>
</template>

