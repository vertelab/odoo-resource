<odoo>
    <record id="view_resource_plan_object_wizard_form" model="ir.ui.view">
        <field name="name">resource.plan.object.wizard.form</field>
        <field name="model">resource.plan.object.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Objects to Shifts">
                <!-- Add wizard fields here if needed -->
                <footer>
                    <button name="assign_objects_to_shifts"
                            type="object"
                            string="Assign"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_resource_plan_object_wizard" model="ir.actions.act_window">
        <field name="name">Assign Objects to Shifts</field>
        <field name="res_model">resource.plan.object.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_resource_plan_object_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>
