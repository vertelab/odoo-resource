<odoo>
  <data>
    <record id="action_assign_shifts" model="ir.actions.server">
      <field name="name">Assign Shifts</field>
      <field name="model_id" ref="resource_planning.model_resource_shift" />
      <field name="binding_model_id" ref="resource_planning.model_resource_shift" />
      <field name="state">code</field>
      <field name="code">model.action_assign_shifts()</field>
    </record>
    <!-- From Views -->
    
    <record id="view_resource_role_form" model="ir.ui.view">
      <field name="name">resource.role.form</field>
      <field name="model">resource.role</field>
      <field name="arch" type="xml">
        <form string="Resource Role">
          <sheet>
            <div class="oe_title pe-0">
              <h1 class="d-flex justify-content-between align-items-center">
                <div class="d-flex w-100">
                  <field name="name" options="{'line_breaks': False}" widget="text" class="o_task_name text-truncate w-md-75 w-100 pe-2" placeholder="Role..." />
                </div>
              </h1>
            </div>
            <group>
              <field name="description" />
              <field name="resource_ids" widget="many2many_tags" domain="[('resource_type','=',resource_type)]" />
              <field name="resource_type" />
            </group>
            <group>
                <field name="resource_object_ids"/>
            </group>
          </sheet>
          <chatter />
        </form>
      </field>
    </record>
    
    
     <record id="view_resource_object_form" model="ir.ui.view">
      <field name="name">resource.object.form</field>
      <field name="model">resource.object</field>
      <field name="arch" type="xml">
        <form string="Resource Object">
            <header>
                <button name="create_resource_shift_objects"
                type="object"
                string="Create Shift Objects"
                class="btn-primary"/>
            </header>
          <sheet>
            <div class="oe_button_box" name="button_box">
                    <button name="action_open_shift_objects"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-list"
                            string="Shift Objects">
                        <field name="shift_object_ids" widget="statinfo"/>
                    </button>
            </div>
            <div class="oe_title pe-0">
              <h1 class="d-flex justify-content-between align-items-center">
                <div class="d-flex w-100">
                  <field name="name" options="{'line_breaks': False}" widget="text" class="o_task_name text-truncate w-md-75 w-100 pe-2" placeholder="Object description..." />
                </div>
              </h1>
            </div>
            <group>
              <field name="model_id" />
              <field name="model_name" invisible="1" />
              <field name="filter_domain" widget="domain" options="{'model': 'model_name'}" />
              <field name="order_by_field"/>
              <field name="eval_duration"/>
                <label for="eval_duration" string="Help"/>
                <div class="oe_edit_only" style="color: #888; margin-bottom: 8px;">
                    <p>
                        <b>Python Expression:</b> Use <code>record</code> for the current record.<br/>
                        Example: <code>record.some_field * 2 if record.some_field else 1</code><br/>
                        The result will be used as the duration.
                    </p>
                </div>
            </group>
          </sheet>
          <chatter />
        </form>
      </field>
    </record>
    
    <record id="view_resource_week_template_form" model="ir.ui.view">
      <field name="name">resource.week.template.form</field>
      <field name="model">resource.week.template</field>
      <field name="arch" type="xml">
        <form string="Week Template">
          <header>
            <button name="update_template_lines" type="object" string="Updated Shifts" class="btn-primary" />
          </header>
          <sheet>
            <div name="button_box" id="button_box" class="oe_button_box">
              <button name="week_template_shift_action" class="oe_stat_button " type="object" icon="fa-calendar">
                <field string="Template Shifts" name="week_template_shift_count" widget="statinfo" />
              </button>
            </div>
            <div class="oe_title pe-0">
              <h1 class="d-flex justify-content-between align-items-center">
                <div class="d-flex w-100">
                  <field name="name" options="{'line_breaks': False}" widget="text" class="o_task_name text-truncate w-md-75 w-100 pe-2" placeholder="Week..." />
                </div>
              </h1>
            </div>
            <notebook>
              <page string="Shift Data">
                <group>
                  <field name="week_template_line_ids" nolabel="1" no_open="1">
                    <list create="false" edit="false" delete="false">
                      <field name="role_id" />
                      <field name="duration" widget="float_time" sum="True" />
                    </list>
                  </field>
                </group>
              </page>
            </notebook>
          </sheet>
          <chatter />
        </form>
      </field>
    </record>
    
    <record id="view_resource_week_template_shift_form" model="ir.ui.view">
      <field name="name">resource.week.template.shift.form</field>
      <field name="model">resource.week.template.shift</field>
      <field name="arch" type="xml">
        <form string="Resource Template Shifts">
          <header>
            <button name="action_template_shift_wizard" type="object" string="Generate Shifts" class="btn-primary" display="always" />
          </header>
          <sheet>
            <div class="oe_title pe-0">
              <h1 class="d-flex justify-content-between align-items-center">
                <div class="d-flex w-100">
                  <field name="name" options="{'line_breaks': False}" widget="text" class="o_task_name text-truncate w-md-75 w-100 pe-2" placeholder="Shift" />
                </div>
              </h1>
            </div>
            <group>
              <field name="date_start" />
              <field name="date_stop" />
            </group>
            <group>
              <field name="role_id" />
              <field name="duration" widget="float_time" />
            </group>
          </sheet>
          <chatter />
        </form>
      </field>
    </record>
    <!-- List Views -->
    <record id="view_resource_role_tree" model="ir.ui.view">
      <field name="name">resource.role.tree</field>
      <field name="model">resource.role</field>
      <field name="arch" type="xml">
        <list string="resource Roles">
          <field name="name" />
        </list>
      </field>
    </record>
    
    <record id="view_resource_object_tree" model="ir.ui.view">
      <field name="name">resource.object.tree</field>
      <field name="model">resource.object</field>
      <field name="arch" type="xml">
        <list string="Resource Objects">
          <field name="name" />
          <button name="action_open_form"
                    type="object"
                    string="View"
                    icon="fa-eye"/>
        </list>
      </field>
    </record>
   
    <record id="view_resource_week_template_shift_tree" model="ir.ui.view">
      <field name="name">resource.week.template.shift.tree</field>
      <field name="model">resource.week.template.shift</field>
      <field name="arch" type="xml">
        <list string="Template Shifts">
          <header>
            <button name="action_template_shift_wizard" type="object" string="Copy Shifts" class="btn-primary" display="always" />
          </header>
          <field name="name" />
        </list>
      </field>
    </record>
    <!-- Search Views -->
    
    <record id="resource_week_template_shift_search" model="ir.ui.view">
      <field name="name">resource.week.template.shift.search</field>
      <field name="model">resource.week.template.shift</field>
      <field name="arch" type="xml">
        <search string="Search Template Shifts">
          <field name="name" />
          <field name="day" />
          <field name="role_id" />
          <filter string="Monday" name="monday" domain="[('day', '=', 0)]" />
          <filter string="Tuesday" name="tuesday" domain="[('day', '=', 1)]" />
          <filter string="Wednesday" name="wednesday" domain="[('day', '=', 2)]" />
          <filter string="Thursday" name="thursday" domain="[('day', '=', 3)]" />
          <filter string="Friday" name="friday" domain="[('day', '=', 4)]" />
          <filter string="Saturday" name="saturday" domain="[('day', '=', 5)]" />
          <filter string="Sunday" name="sunday" domain="[('day', '=', 6)]" />
          <group expand="0" string="Group By">
            <filter string="Days" name="group_by_day" context="{'group_by': 'day'}" />
            <filter string="Roles" name="group_by_role" context="{'group_by': 'role_id'}" />
          </group>
        </search>
      </field>
    </record>
    
    
    <record id="resource_object_search_view" model="ir.ui.view">
        <field name="name">resource.object.search</field>
        <field name="model">resource.object</field>
        <field name="arch" type="xml">
            <search string="Resource Objects">
                <!-- Quick search fields -->
                <field name="name"/>
                <field name="model_id"/>
                <field name="model_name"/>
                <field name="order_by_field"/>
                <field name="filter_domain"/>
                <!-- Group by -->
                <group expand="0" string="Group By">
                    <filter name="group_by_model" string="Model" context="{'group_by':'model_id'}"/>
                </group>
            </search>
        </field>
    </record>
    
    

    <record id="resource_shift_object_search_view" model="ir.ui.view">
        <field name="name">resource.shift.object.search</field>
        <field name="model">resource.shift.object</field>
        <field name="arch" type="xml">
            <search string="Shift Objects">
                <field name="name"/>
                <field name="shift_id"/>
                <field name="object_description_id"/>
                <field name="reference_model" string="Reference Model"/>
                <field name="duration"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_reference_model" string="Reference Model" context="{'group_by': 'reference_model'}"/>
                    <filter name="group_by_shift" string="Shift" context="{'group_by': 'shift_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban Views -->
   
   
    <record id="resource_week_template_shift_kanban" model="ir.ui.view">
        <field name="name">resource.week.template.shift.kanban</field>
        <field name="model">resource.week.template.shift</field>
        <field name="arch" type="xml">
            <kanban>
                 <header>
            <button name="action_template_shift_wizard" type="object" string="Copy Shifts" class="btn-primary" display="always" />
          </header>
                <field name="name"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <field name="name"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
   
    <record id="view_resource_week_template_calendar" model="ir.ui.view">
      <field name="name">resource.week.template.calendar</field>
      <field name="model">resource.week.template.shift</field>
      <field name="arch" type="xml">
        <calendar string="Week Template" mode="week" date_start="date_start" date_stop="date_stop" date_delay="duration" scales="week" quick_create="false" event_open_popup="true" color="role_id" hide_time="true">
          <field name="name" />
          <field name="role_id" filters="1" />
        </calendar>
      </field>
    </record>
    <!-- Pivot Views -->
    <record id="view_resource_week_template_shift_pivot" model="ir.ui.view">
      <field name="name">resource.week.template.pivot.view</field>
      <field name="model">resource.week.template.shift</field>
      <field name="arch" type="xml">
        <pivot string="Template Shifts" />
      </field>
    </record>
    
  </data>
</odoo>
