<odoo>

    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.resource.smart.button.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="get_shifts" class="oe_stat_button" type="object" icon="fa-calendar">
                    <field string="Shifts" name="resource_shift_count" widget="statinfo" />
                </button>
            </div>
        </field>
    </record>

</odoo>