<odoo>
    <data>

        <!-- From Views -->

        <record id="view_resource_planning_form" model="ir.ui.view">
            <field name="name">resource.planning.form</field>
            <field name="model">resource.planning</field>
            <field name="arch" type="xml">
                <form string="Resource Planning">
                    <sheet>
                        <div name="button_box" id="button_box" class="oe_button_box">
                            <button name="get_plans" class="oe_stat_button " type="object" icon="fa-calendar">
                                <field string="Plans" name="plan_count" widget="statinfo" />
                            </button>
                        </div>
                        <div class="oe_title pe-0">
                            <h1 class="d-flex justify-content-between align-items-center">
                                <div class="d-flex w-100">
                                    <field name="name" options="{'line_breaks': False}" widget="text" class="o_task_name text-truncate w-md-75 w-100 pe-2" placeholder="Name..."/>
                                </div>
                            </h1>
                        </div>
                        <group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_resource_plan_form" model="ir.ui.view">
            <field name="name">resource.plan.form</field>
            <field name="model">resource.plan</field>
            <field name="arch" type="xml">
                <form string="Resource Planning">
                    <header>
                        <button name="create_shifts" type="object" string="Generate Shifts" class="btn-primary"/>
                        <button name="update_data_lines" type="object" string="Update Data" class="btn-primary"/>
                    </header>
                    <sheet>
                        <div name="button_box" id="button_box" class="oe_button_box">
                            <button name="action_get_shifts" class="oe_stat_button " type="object" icon="fa-calendar">
                                <field string="Shifts" name="shift_count" widget="statinfo" />
                            </button>
                            <button name="action_get_slots" class="oe_stat_button " type="object" icon="fa-th">
                                <field string="Slots" name="slot_count" widget="statinfo" />
                            </button>
                        </div>
                        <div class="oe_title pe-0">
                            <h1 class="d-flex justify-content-between align-items-center">
                                <div class="d-flex w-100">
                                    <field name="name" options="{'line_breaks': False}" widget="text" class="o_task_name text-truncate w-md-75 w-100 pe-2" placeholder="Month..."/>
                                </div>
                            </h1>
                        </div>
                        <group>
                            <field name="date_start" required="True"/>
                            <field name="week_template_ids" widget="many2many_tags"/>
                        </group>
                        <notebook>
                            <page string="Roles Data">
                                <field name="plan_role_ids">
                                    <list>
                                        <field name="role_id" />
                                        <field name="duration" widget="float_time"/>
                                        <field name="worked_hours" widget="float_time"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Resource Data">
                                <field name="plan_resource_ids">
                                    <list>
                                        <field name="resource_id" />
                                        <field name="duration" widget="float_time"/>
                                        <field name="worked_hours" widget="float_time"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_resource_role_form" model="ir.ui.view">
            <field name="name">resource.role.form</field>
            <field name="model">resource.role</field>
            <field name="arch" type="xml">
                <form string="Resource Role">
                    <sheet>
                        <div class="oe_title pe-0">
                            <h1 class="d-flex justify-content-between align-items-center">
                                <div class="d-flex w-100">
                                    <field name="name" options="{'line_breaks': False}" widget="text" class="o_task_name text-truncate w-md-75 w-100 pe-2" placeholder="Role..."/>
                                </div>
                            </h1>
                        </div>
                        <group>
                            <field name="description"/>
                            <field name="resource_ids" widget="many2many_tags"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_resource_shift_form" model="ir.ui.view">
            <field name="name">resource.shift.form</field>
            <field name="model">resource.shift</field>
            <field name="arch" type="xml">
                <form string="resource Shift">
                    <sheet>
                        <div class="oe_title pe-0">
                            <h1 class="d-flex justify-content-between align-items-center">
                                <div class="d-flex w-100">
                                    <field name="name" options="{'line_breaks': False}" widget="text" class="o_task_name text-truncate w-md-75 w-100 pe-2" placeholder="Shift"/>
                                </div>
                            </h1>
                        </div>
                        <group>
                            <field name="role_id"/>
                            <field name="slot_id"/>
                            <field name="resource_id"/>
                            <field name="date_start"/>
                            <field name="date_stop"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_resource_week_template_form" model="ir.ui.view">
            <field name="name">resource.week.template.form</field>
            <field name="model">resource.week.template</field>
            <field name="arch" type="xml">
                <form string="Week Template">
                    <header>
                        <button name="update_template_lines" type="object" string="Updated Shifts" class="btn-primary"/>
                    </header>
                    <sheet>
                        <div name="button_box" id="button_box" class="oe_button_box">
                            <button name="week_template_shift_action" class="oe_stat_button " type="object" icon="fa-calendar">
                                <field string="Template Shifts" name="week_template_shift_count" widget="statinfo" />
                            </button>
                        </div>
                        <div class="oe_title pe-0">
                            <h1 class="d-flex justify-content-between align-items-center">
                                <div class="d-flex w-100">
                                    <field name="name" options="{'line_breaks': False}" widget="text" class="o_task_name text-truncate w-md-75 w-100 pe-2" placeholder="Week..."/>
                                </div>
                            </h1>
                        </div>
                        <notebook>
                            <page string="Shift Data">
                                <group>
                                    <field name="week_template_line_ids" nolabel="1">
                                        <list>
                                            <field name="role_id"/>
                                            <field name="duration" widget="float_time"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_resource_week_template_shift_form" model="ir.ui.view">
            <field name="name">resource.week.template.shift.form</field>
            <field name="model">resource.week.template.shift</field>
            <field name="arch" type="xml">
                <form string="Resource Template Shifts">
                    <header>
                        <button name="action_template_shift_wizard" type="object" string="Generate Shifts" class="btn-primary" display="always"/>
                    </header>
                    <sheet>
                        <div class="oe_title pe-0">
                            <h1 class="d-flex justify-content-between align-items-center">
                                <div class="d-flex w-100">
                                    <field name="name" options="{'line_breaks': False}" widget="text" class="o_task_name text-truncate w-md-75 w-100 pe-2" placeholder="Shift"/>
                                </div>
                            </h1>
                        </div>
                        <group>
                            <field name="date_start"/>
                            <field name="date_stop"/>
                        </group>
                        <group>
                            <field name="role_id"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- List Views -->

        <record id="view_resource_role_tree" model="ir.ui.view">
            <field name="name">resource.role.tree</field>
            <field name="model">resource.role</field>
            <field name="arch" type="xml">
                <list string="resource Roles">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="view_resource_shift_tree" model="ir.ui.view">
            <field name="name">resource.shift.tree</field>
            <field name="model">resource.shift</field>
            <field name="arch" type="xml">
                <list string="resource Shifts">
                    <field name="name"/>
                    <field name="role_id"/>
                    <field name="date_start"/>
                    <field name="duration" widget="float_time"/>
                    <field name="date_stop"/>
                </list>
            </field>
        </record>

        <record id="view_resource_week_template_shift_tree" model="ir.ui.view">
            <field name="name">resource.week.template.shift.tree</field>
            <field name="model">resource.week.template.shift</field>
            <field name="arch" type="xml">
                <list string="Template Shifts">
                    <header>
                        <button name="action_template_shift_wizard" type="object" string="Generate Shifts" class="btn-primary" display="always"/>
                    </header>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!-- Search Views -->

        <record id="resource_shift_search" model="ir.ui.view">
            <field name="name">resource.shift.search</field>
            <field name="model">resource.shift</field>
            <field name="arch" type="xml">
                <search string="Search Shifts">
                    <field name="name" />
                    <field name="day" />
                    <field name="role_id" />
                    <field name="resource_id" />
                    <field name="date_start"/>
                    <field name="week_number_string"/>
                    <filter string="Start Date" name="date_start" date="date_start" />
                    <filter string="Monday" name="monday" domain="[('day', '=', 0)]" />
                    <filter string="Tuesday" name="tuesday" domain="[('day', '=', 1)]" />
                    <filter string="Wednesday" name="wednesday" domain="[('day', '=', 2)]" />
                    <filter string="Thursday" name="thursday" domain="[('day', '=', 3)]" />
                    <filter string="Friday" name="friday" domain="[('day', '=', 4)]" />
                    <filter string="Saturday" name="saturday" domain="[('day', '=', 5)]" />
                    <filter string="Sunday" name="sunday" domain="[('day', '=', 6)]" />
                    <!-- <filter string="Current Week" domain="[('week_number_string', '=', (context_today()+relativedelta(weeks=0)).strftime('%%W'))]"/> -->
                    <filter string="Next Week" name="next_week" domain="[('date_start','&gt;=', (context_today() + relativedelta(weeks=1)).strftime('%%Y-%%m-01')), 
                        ('date_start','&lt;', (context_today() + relativedelta(weeks=2)).strftime('%%Y-%%m-01'))]"/>
                    <filter string="Last Week" name="last_week" domain="[('date_start','&gt;=', (context_today() - relativedelta(weeks=1)).strftime('%%Y-%%m-01')), 
                        ('date_start','&lt;', context_today().strftime('%%Y-%%m-01'))]"/>
                    <group expand="0" string="Group By">
                        <filter string="Days" name="group_by_day" context="{'group_by': 'day'}" />
                        <filter string="Roles" name="group_by_role" context="{'group_by': 'role_id'}" />
                    </group>
                </search>
            </field>
        </record>

        <record id="resource_week_template_shift_search" model="ir.ui.view">
            <field name="name">resource.week.template.shift.search</field>
            <field name="model">resource.week.template.shift</field>
            <field name="arch" type="xml">
                <search string="Search Template Shifts">
                    <field name="name" />
                    <field name="day" />
                    <field name="role_id" />
                    <filter string="Monday" name="monday" domain="[('day', '=', 0)]" />
                    <filter string="Tuesday" name="tuesday" domain="[('day', '=', 1)]" />
                    <filter string="Wednesday" name="wednesday" domain="[('day', '=', 2)]" />
                    <filter string="Thursday" name="thursday" domain="[('day', '=', 3)]" />
                    <filter string="Friday" name="friday" domain="[('day', '=', 4)]" />
                    <filter string="Saturday" name="saturday" domain="[('day', '=', 5)]" />
                    <filter string="Sunday" name="sunday" domain="[('day', '=', 6)]" />
                    <group expand="0" string="Group By">
                        <filter string="Days" name="group_by_day" context="{'group_by': 'day'}" />
                        <filter string="Roles" name="group_by_role" context="{'group_by': 'role_id'}" />
                    </group>
                </search>
            </field>
        </record>

        <!-- Kanban Views -->

        <!-- Calandar Views -->

        <record id="view_resource_shift_calendar" model="ir.ui.view">
            <field name="name">resource.calendar</field>
            <field name="model">resource.shift</field>
            <field name="arch" type="xml">
                <calendar string="Week Template" mode="week" date_start="date_start" date_stop="date_stop" date_delay="duration" color="resource_id" hide_time="true">
                    <field name="name"/>
                    <field name="role_id" filters="1" />
                    <field name="resource_id" filters="1" />
                </calendar>
            </field>
        </record>

        <record id="view_resource_week_template_calendar" model="ir.ui.view">
            <field name="name">resource.week.template.calendar</field>
            <field name="model">resource.week.template.shift</field>
            <field name="arch" type="xml">
                <calendar string="Week Template" mode="week" date_start="date_start" date_stop="date_stop" date_delay="duration" scales="week" quick_create="false" event_open_popup="true" color="role_id" hide_time="true">
                    <field name="name"/>
                    <field name="role_id" filters="1" />
                </calendar>
            </field>
        </record>

        <!-- Pivot Views -->

        <record id="view_resource_week_template_shift_pivot" model="ir.ui.view">
            <field name="name">resource.week.template.pivot.view</field>
            <field name="model">resource.week.template.shift</field>
            <field name="arch" type="xml">
                <pivot string="Template Shifts">

                </pivot>
            </field>
        </record>

    </data>
</odoo>


       

