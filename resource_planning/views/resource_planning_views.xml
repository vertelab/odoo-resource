<odoo>
  <data>
   
    <!-- From Views -->
    <record id="view_resource_planning_form" model="ir.ui.view">
      <field name="name">resource.planning.form</field>
      <field name="model">resource.planning</field>
      <field name="arch" type="xml">
        <form string="Resource Planning">
          <sheet>
            <div name="button_box" id="button_box" class="oe_button_box">
              <button name="get_plans" class="oe_stat_button " type="object" icon="fa-calendar">
                <field string="Plans" name="plan_count" widget="statinfo" />
              </button>
            </div>
            <!--
                 <div class="oe_title pe-0">
                 <h1 class="d-flex justify-content-between align-items-center">
                 <div class="d-flex w-100">
                 <field name="name" options="{'line_breaks': False}" widget="text" class="o_task_name text-truncate w-md-75 w-100 pe-2" placeholder="Name..."/>
                 </div>
                 </h1>
                 </div>
            -->
            <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
            <div class="row justify-content-between position-relative w-100 m-0 mb-2">
              <div class="oe_title mw-75 ps-0 pe-2">
                <h1 class="d-flex flex-row align-items-center">
                  <field name="name" placeholder="Planning entity" required="True" style="font-size: min(4vw, 2rem);" />
                </h1>
              </div>
              <div class="o_employee_avatar m-0 p-0">
                <field name="image_128" widget='image' class="oe_avatar m-0" />
              </div>
            </div>
            <group>
              <field name="company_id" groups="base.group_multi_company" />
              <field name="department_id" />    
              <field name="tz"/>
              <field name="resource_calendar_id"/>
            </group>
            <!-- <notebook>
                 <page string="Roles Data">
                 <field name="plan_role_ids">
                 <list>
                 <field name="role_id" />
                 <field name="duration" widget="float_time"/>
                 <field name="worked_hours" widget="float_time"/>
                 </list>
                 </field>
                 </page>
                 <page string="Resource Data">
                 <field name="plan_resource_ids">
                 <list>
                 <field name="resource_id" />
                 <field name="duration" widget="float_time"/>
                 <field name="worked_hours" widget="float_time"/>
                 </list>
                 </field>
                 </page>
                 </notebook> -->
          </sheet>
          <chatter />
        </form>
      </field>
    </record>
    <record id="resource_planning_kanban" model="ir.ui.view">
      <field name="name">resource.planning.kanban</field>
      <field name="model">resource.planning</field>
      <field name="arch" type="xml">
        <kanban highlight_color="color" quick_create="true">
          <header>
            <!--
                 <button name="action_assign_shifts" type="object" string="Assign Shifts" class="btn-primary" display="always" />
            -->
          </header>
          <field name="color" />
          <field name="name" />
          <field name="status_color" />
          <field name="image_128" />
          <!--
               <field name="show_hr_icon_display" />
               <field name="hr_icon_display" />
          -->
          <field name="company_id" />
          <progressbar field="activity_state" colors="{&quot;planned&quot;: &quot;success&quot;, &quot;today&quot;: &quot;warning&quot;, &quot;overdue&quot;: &quot;danger&quot;}" sum_field="duration" recurring_revenue_sum_field="worked_hours" help="This bar allows to filter the opportunities based on scheduled activities." />
          <templates>
            <t t-name="menu">
              <a role="menuitem" type="open" class="dropdown-item" t-if="widget.editable">Edit</a>
              <a role="menuitem" type="delete" class="dropdown-item" t-if="widget.deletable">Delete</a>
              <field name="color" widget="kanban_color_picker" />
            </t>
            <t t-name="card" class="flex-row">
              <aside class="o_kanban_aside_full">
                <t t-if="record.image_128.raw_value">
                  <field name="image_128" widget="background_image" options="{'zoom': true, 'zoom_delay': 1000}" class="d-block position-relative" />
                </t>
                <div t-else="" class="d-flex align-items-center justify-content-center bg-100 bg-gradient">
                  <svg class="w-75 h-75 opacity-50" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <g fill="currentColor">
                      <!-- Fabriksbyggnad -->
                      <rect x="2" y="10" width="20" height="10" rx="2" />
                      <!-- Skorstenar -->
                      <rect x="5" y="6" width="2" height="6" />
                      <rect x="9" y="4" width="2" height="8" />
                      <rect x="13" y="7" width="2" height="5" />
                      <!-- Rök från skorstenar -->
                      <path d="M6 4 Q6.5 2, 7 4" stroke="currentColor" fill="none" />
                      <path d="M10 2 Q10.5 0, 11 2" stroke="currentColor" fill="none" />
                      <path d="M14 5 Q14.5 3, 15 5" stroke="currentColor" fill="none" />
                      <!-- Fönster -->
                      <rect x="16" y="14" width="2" height="2" fill="#fff" />
                      <rect x="12" y="14" width="2" height="2" fill="#fff" />
                      <rect x="8" y="14" width="2" height="2" fill="#fff" />
                    </g>
                  </svg>
                </div>
              </aside>
              <main class="ms-2">
                <div>
                  <field class="fw-bold fs-5" name="name" placeholder="Shift Name" />
                </div>
                <span>
                <field string="Plans" name="plan_count"  style="margin-right: 0px;" />
                <button string="Plans" name="get_plans" class="oe_stat_button " type="object" />
                </span>
                <field name="use_slots" invisible="True"/>
                <span>
                    Today
                <button  name="get_today" type="object" icon="fa-trello"/>
                <button  name="get_today_slots" type="object" icon="fa-cubes" invisible="use_slots == False"/>
                </span>
                <footer>
                  <div class="d-flex justify-content-between align-items-center w-100">
                    <div class="d-flex align-items-center">
                      <span class="fa fa-clock-o me-2" title="Dates" />
                      <!--
                           <field name="last_run" t-if="record.last_run.value != False" />
                      -->
                    </div>
                    <span t-att-class="'o_status_bubble mx-0 o_color_bubble_' + record.status_color.value or 0" />
                  </div>
                </footer>
              </main>
            </t>
          </templates>
        </kanban>
      </field>
    </record>
    
    
        <!-- Search Views -->
    <record id="resource_planning_search" model="ir.ui.view">
      <field name="name">resource.planning.search</field>
      <field name="model">resource.planning</field>
      <field name="arch" type="xml">
        <search string="Search Shifts">
          <field name="name" />

          <field name="department_id" />


          <group expand="0" string="Group By">

            <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}" />
          </group>
        </search>
      </field>
    </record>
  </data>
</odoo>

