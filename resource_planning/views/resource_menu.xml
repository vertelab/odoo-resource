<odoo>
    <data>
        <!-- Actions -->

        <!-- Action for Shifts -->
        
        <record id="action_resource_plan" model="ir.actions.act_window">
            <field name="name">Resource Planning</field>
            <field name="res_model">resource.planning</field>
            <field name="view_mode">kanban,list,form,calendar</field>
        </record>

        <record id="action_resource_planning" model="ir.actions.act_window">
            <field name="name">Resource Planning</field>
            <field name="res_model">resource.planning</field>
            <field name="view_mode">kanban,list,form,calendar</field>
        </record>

        
        <record id="action_resource_shifts" model="ir.actions.act_window">
            <field name="name">Shifts</field>
            <field name="res_model">resource.shift</field>
            <field name="view_mode">kanban,calendar,list,form,pivot</field>
            <field name="help">Manage shifts and their associated roles and timings.</field>
        </record>

        <!-- Action for Roles -->
        <record id="action_resource_roles" model="ir.actions.act_window">
            <field name="name">Roles</field>
            <field name="res_model">resource.role</field>
            <field name="view_mode">list,form</field>
            <field name="help">Manage resource roles and assign resources to them.</field>
        </record>
        
        <record id="action_resource_objects" model="ir.actions.act_window">
            <field name="name">Object Description</field>
            <field name="res_model">resource.object</field>
            <field name="view_mode">list,form</field>
            <field name="help">Manage object descriptions.</field>
        </record>


        <record id="action_resource_week_template" model="ir.actions.act_window">
            <field name="name">Resource Week Template</field>
            <field name="res_model">resource.week.template</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_resource_slot" model="ir.actions.act_window">
            <field name="name">Resource Slot</field>
            <field name="res_model">resource.slot</field>
            <field name="view_mode">kanban,list,form</field>
        </record>

        <record id="action_resources" model="ir.actions.act_window">
            <field name="name">Resources</field>
            <field name="res_model">resource.resource</field>
            <field name="view_mode">list,form</field>
        </record>
        
        <record id="action_resource_slot_object" model="ir.actions.act_window">
            <field name="name">Resource Slot Objects</field>
            <field name="res_model">resource.shift.object</field>
            <field name="view_mode">list,form</field>
        </record>


        <!-- Main Menu -->
        <menuitem id="menu_resource_root" name="Resource Planner" sequence="10"/>

        <menuitem id="menu_resource_planning" name="Planning" parent="menu_resource_root" action="action_resource_planning" sequence="10"/>

        <!-- <menuitem id="menu_resource_plan" name="Plan" parent="menu_resource_root" action="action_resource_plan" sequence="10"/> -->

        <menuitem id="menu_resource_plan_configuration" name="Configuration" parent="menu_resource_root" sequence="11"/>

        <menuitem id="menu_resource_roles" name="Roles" parent="menu_resource_plan_configuration" action="action_resource_roles" sequence="40"/>
        
        <menuitem id="menu_resource_objects" name="Objects" parent="menu_resource_plan_configuration" action="action_resource_objects" sequence="40"/>

        <menuitem id="menu_resource_week_template" name="Week Template" parent="menu_resource_plan_configuration" action="action_resource_week_template" sequence="40"/>

        <menuitem id="menu_resources" name="Resources" parent="menu_resource_plan_configuration" action="action_resources" sequence="40"/>
        
        <menuitem id="menu_resource_slot_object" parent="menu_resource_plan_configuration" name="Resource Slot Objects" action="action_resource_slot_object"/>

        <!-- <menuitem id="menu_resource_shifts" name="Shifts" parent="menu_resource_root" action="action_resource_shifts" sequence="40"/> -->

        <!-- <menuitem id="menu_resource_slot_root" name="Slots" parent="menu_resource_root" action="action_resource_slot" sequence="40"/> -->

    </data>
</odoo>
