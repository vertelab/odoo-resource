<odoo>
  <data>
    <record id="action_assign_shifts" model="ir.actions.server">
      <field name="name">Assign Shifts</field>
      <field name="model_id" ref="resource_planning.model_resource_shift" />
      <field name="binding_model_id" ref="resource_planning.model_resource_shift" />
      <field name="state">code</field>
      <field name="code">model.action_assign_shifts()</field>
    </record>
    <!-- From Views -->
    
   
    <record id="view_resource_shift_form" model="ir.ui.view">
      <field name="name">resource.shift.form</field>
      <field name="model">resource.shift</field>
      <field name="arch" type="xml">
        <form string="resource Shift">
          <sheet>
            <div name="button_box" id="button_box" class="oe_button_box">
                <button name="action_view_shift_objects"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cubes"
                        string="Assigned Objects"
                        >
                    <field string="Assigned Objects" name="shift_object_ids" widget="statinfo"/>
                </button>
            </div>
            <div class="oe_title pe-0">
              <h1 class="d-flex justify-content-between align-items-center">
                <div class="d-flex w-100">
                  <field name="name" options="{'line_breaks': False}" widget="text" class="o_task_name text-truncate w-md-75 w-100 pe-2" placeholder="Shift" />
                </div>
              </h1>
            </div>
            <group>
              <field name="role_id" />
              <field name="slot_id" />
              <field name="resource_id" />
              <field name="date_start" />
              <field name="date_stop" />
              <field name="duration" widget="float_time" />
              <field name="assigned_duration" widget="float_time" />
            </group>
          </sheet>
          <chatter />
        </form>
      </field>
    </record>
        
    <record id="view_resource_slot_object_form" model="ir.ui.view">
        <field name="name">resource.shift.object.form</field>
        <field name="model">resource.shift.object</field>
        <field name="arch" type="xml">
            <form string="Resource Slot Object">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="shift_id"/>
                        <field name="reference_id"/>
                        <field name="duration"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    
    <!-- List Views -->
    
    <record id="view_resource_shift_list" model="ir.ui.view">
      <field name="name">resource.shift.list</field>
      <field name="model">resource.shift</field>
      <field name="arch" type="xml">
        <list string="resource Shifts">
          <header>
            <button name="action_assign_shifts" type="object" string="Assign Shifts" class="btn-primary" display="always" />
          </header>
          <field name="name" />
          <field name="role_id" optional="hide" />
          <field name="date_start" optional="hide" />
          <field name="date_stop" optional="hide" />
          <field name="duration" widget="float_time" sum="True" optional="hide" />
          <field name="worked_hours" widget="float_time" sum="True" optional="hide" />
        <button name="unset_resource" class="oe_stat_button" type="object" icon="fa-user-times" />
                   
<!--
            <span t-att-class="'o_status_bubble mx-0 o_color_bubble_' + record.status_color.value or 0" t-att-tooltip="record.status_title.value" />
-->
               
          
        </list>
      </field>
    </record>
    
    <record id="view_resource_slot_object_list" model="ir.ui.view">
        <field name="name">resource.shift.object.list</field>
        <field name="model">resource.shift.object</field>
        <field name="arch" type="xml">
            <list string="Resource Slot Objects">
                <field name="name"/>
                <field name="shift_id"/>
                <field name="reference_id"/>
                <field name="duration"/>
                <button name="action_open_form"
                        type="object"
                        string="View"
                        icon="fa-eye"
                        />
            </list>
        </field>
    </record>

   
    <!-- Search Views -->
    <record id="resource_shift_search" model="ir.ui.view">
      <field name="name">resource.shift.search</field>
      <field name="model">resource.shift</field>
      <field name="arch" type="xml">
        <search string="Search Shifts">
          <field name="name" />
          <field name="day" />
          <field name="role_id" />
          <field name="resource_id" />
          <field name="date_start" />
          <field name="department_id" />
          <field name="week_number_string" />
          <field name="plan_id" />
          <filter string="Start Date" name="date_start" date="date_start" />
          <filter string="Monday" name="monday" domain="[('day', '=', 0)]" />
          <filter string="Tuesday" name="tuesday" domain="[('day', '=', 1)]" />
          <filter string="Wednesday" name="wednesday" domain="[('day', '=', 2)]" />
          <filter string="Thursday" name="thursday" domain="[('day', '=', 3)]" />
          <filter string="Friday" name="friday" domain="[('day', '=', 4)]" />
          <filter string="Saturday" name="saturday" domain="[('day', '=', 5)]" />
          <filter string="Sunday" name="sunday" domain="[('day', '=', 6)]" />
<!--
           <filter string="Current Week" domain="[('week_number_string', '=', (context_today()+relativedelta(weeks=0)).strftime('%%W'))]"/> 
-->
          <filter string="This Week" name="this_week" domain="[('date_start','&gt;=', (context_today() + relativedelta(weeks=-1)).strftime('%%Y-%%m-01')), 
                        ('date_start','&lt;', (context_today() + relativedelta(weeks=1)).strftime('%%Y-%%m-01'))]" />
          <filter string="Next Week" name="next_week" domain="[('date_start','&gt;=', (context_today() + relativedelta(weeks=1)).strftime('%%Y-%%m-01')), 
                        ('date_start','&lt;', (context_today() + relativedelta(weeks=2)).strftime('%%Y-%%m-01'))]" />
          <filter string="Last Week" name="last_week" domain="[('date_start','&gt;=', (context_today() - relativedelta(weeks=1)).strftime('%%Y-%%m-01')), 
                        ('date_start','&lt;', context_today().strftime('%%Y-%%m-01'))]" />
          <group expand="0" string="Group By">
            <filter string="Days" name="group_by_day" context="{'group_by': 'day'}" />
            <filter string="Resources" name="group_by_resource" context="{'group_by': 'resource_id'}" />
            <filter string="Roles" name="group_by_role" context="{'group_by': 'role_id'}" />
            <filter string="Week" name="group_by_week" context="{'group_by': 'week_number'}" />
            <filter string="Date" name="group_by_date" context="{'group_by': 'date_start'}" />
            <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}" />
          </group>
        </search>
      </field>
    </record>

    <!-- Kanban Views -->
    <record id="resource_shift_kanban" model="ir.ui.view">
      <field name="name">resource.shift.kanban</field>
      <field name="model">resource.shift</field>
      <field name="arch" type="xml">
        <kanban highlight_color="color" quick_create="false" editable="true">
            <field name="has_unassigned_shifts" invisible="1"/>
            <field name="any_unassigned" invisible="1"/>
          <header>
              <field name="has_unassigned_shifts" invisible="False"/>
<!--
            <button name="action_assign_shifts" type="object" string="Assign Shifts" class="btn-primary" display="always" invisible="not any_unassigned" />
-->
            <button name="action_assign_shifts" type="object" string="Assign Shifts" class="btn-primary" display="always" />
          </header>
          <field name="color" />
          <field name="company_id" />
          <field name="hr_icon_display" />
          <field name="image_128" />
          <field name="name" />
          <field name="show_hr_icon_display" />
          <field name="status_color" />
          <field name="status_title" />
          <field name="has_unassigned_shifts"/>
          <progressbar field="activity_state" colors="{&quot;planned&quot;: &quot;success&quot;, &quot;today&quot;: &quot;warning&quot;, &quot;overdue&quot;: &quot;danger&quot;}" sum_field="duration" recurring_revenue_sum_field="worked_hours" help="This bar allows to filter the opportunities based on scheduled activities." />
          <templates>
            <t t-name="menu">
              <a role="menuitem" type="open" class="dropdown-item" t-if="widget.editable">Edit</a>
              <a role="menuitem" type="delete" class="dropdown-item" t-if="widget.deletable">Delete</a>
              <field name="color" widget="kanban_color_picker" />
            </t>
            <t t-name="card" class="flex-row">
              <aside class="o_kanban_aside_full">
                <t t-if="record.image_128.raw_value">
                  <field name="image_128" widget="background_image" options="{'zoom': true, 'zoom_delay': 1000}" class="d-block position-relative" />
                </t>
                <div t-else="" class="d-flex align-items-center justify-content-center bg-100 bg-gradient">
                  <svg class="w-75 h-75 opacity-50" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                    <g fill="currentColor">
                      <path d="M 10 11 C 4.08 11 2 14 2 16 L 2 19 L 18 19 L 18 16 C 18 14 15.92 11 10 11 Z" />
                      <circle cx="10" cy="5.5" r="4.5" />
                    </g>
                  </svg>
                </div>
              </aside>
              <main class="ms-2">
                <div>
                  <field class="fw-bold fs-5" name="name" placeholder="Shift Name" />
                  <div t-if="record.show_hr_icon_display.raw_value" class="float-end">
<!--
                    <field name="hr_icon_display" class="o_employee_availability" widget="hr_presence_status" />
-->
                  </div>
                            <field name="has_unassigned_shifts" invisible="False"/>
                </div>
                
                <footer>
                  <div class="d-flex justify-content-between align-items-center w-100">
                    <div class="d-flex align-items-center">
                      <span class="fa fa-clock-o me-2" title="Dates" />
                      <!--
                           <field name="last_run" t-if="record.last_run.value != False" />
                      -->
                    </div>
                    <button name="unset_resource" class="oe_stat_button" type="object" icon="fa-user-times" />
<!--
                    <field name="resource_id" widget="many2one_avatar_user" domain="[('share', '=', False)]" options="{'no_open': True}" class="ms-auto" style="margin-right: 5px;" />
-->
                    <span t-att-class="'o_status_bubble mx-0 o_color_bubble_' + record.status_color.value or 0" t-att-help="record.status_title.value" />
                  </div>
                </footer>
              </main>
            </t>
          </templates>
        </kanban>
      </field>
    </record>
    <!-- Pivot Views -->

    <record id="view_resource_shift_test_form" model="ir.ui.view">
      <field name="name">resource.shift.test.from.view</field>
      <field name="model">resource.shift</field>
      <field name="arch" type="xml">
        <form string="Test Shifts">
          <field name="role_id" />
        </form>
      </field>
    </record>



    <!-- Calandar Views -->

    <record id="view_resource_shift_calendar" model="ir.ui.view">
      <field name="name">resource.shift.calendar</field>
      <field name="model">resource.shift</field>
      <field name="arch" type="xml">
        <calendar string="Week Template" mode="week" date_start="date_start" date_stop="date_stop" date_delay="duration" quick_create="1" quick_create_view_id="%(resource_planning.view_resource_shift_test_form)d" color="resource_id" hide_time="true">
          <field name="name" />
          <field name="role_id" filters="1" />
          <field name="resource_id" filters="1" />
        </calendar>
      </field>
    </record>
   
  </data>
</odoo>
