<odoo>

    <record id="resource_resource_form" model="ir.ui.view">
        <field name="name">resource.resource.roles.form</field>
        <field name="model">resource.resource</field>
        <field name="inherit_id" ref="resource.resource_resource_form" />
        <field name="arch" type="xml">
            <field name="time_efficiency" position="after">
                <field name="role_ids" widget="many2many_tags"/>
            </field>
            <field name="user_id" position="replace">
                <field name="user_id" invisible="resource_type == 'material'"/>
            </field>
        </field>
    </record>

</odoo>
